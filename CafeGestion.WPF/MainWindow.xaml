
<Window x:Class="CafeGestion.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CafeGestion" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#252526" Margin="0">
            <TextBlock Text="CafeGestion" Foreground="#D4A055" FontSize="16"
                       FontWeight="Bold" Margin="16,24,16,32"/>
            <Button x:Name="BtnCafes" Content="Cafes" Style="{StaticResource MenuButton}"/>
            <Button x:Name="BtnImportar" Content="Importar" Style="{StaticResource MenuButton}" Click="BtnImportar_Click"/>
            <Button x:Name="BtnExportar" Content="Exportar" Style="{StaticResource MenuButton}" Click="BtnExportar_Click"/>
            <Button x:Name="BtnAcercaDe" Content="Acerca de" Style="{StaticResource MenuButton}" Click="BtnAcercaDe_Click"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtBuscar" Grid.Row="0" Margin="0,0,0,8"
                     Background="#2D2D2D" Foreground="#888" BorderBrush="#D4A055"
                     Padding="8,6" FontSize="13" Text="Buscar..."
                     TextChanged="TxtBuscar_TextChanged"/>

            <Button x:Name="BtnNuevo" Grid.Row="1" Content="+ Nuevo cafe"
                    Margin="0,0,0,12" Padding="12,6"
                    Background="#D4A055" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Left" Click="BtnNuevo_Click"/>

            <DataGrid x:Name="GridCafes" Grid.Row="2"
                      Background="#2D2D2D" Foreground="White"
                      BorderBrush="#444" GridLinesVisibility="Horizontal"
                      RowBackground="#2D2D2D" AlternatingRowBackground="#333"
                      HeadersVisibility="Column" AutoGenerateColumns="False"
                      SelectionMode="Single" IsReadOnly="True"
                      SelectionChanged="GridCafes_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="100"/>
                    <DataGridTextColumn Header="Variedad" Binding="{Binding Variedad}" Width="100"/>
                    <DataGridTextColumn Header="Puntuacion" Binding="{Binding Puntuacion}" Width="90"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Disponible" Binding="{Binding Disponible}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <ScrollViewer Grid.Column="2" Background="#252526" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="Detalle / Editar" Foreground="#D4A055"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="Nombre" Foreground="#AAA" FontSize="11"/>
                <TextBox x:Name="TxtNombre" Margin="0,4,0,10" Padding="6,4"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Region" Foreground="#AAA" FontSize="11"/>
                <TextBox x:Name="TxtRegion" Margin="0,4,0,10" Padding="6,4"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Origen" Foreground="#AAA" FontSize="11"/>
                <ComboBox x:Name="CmbOrigen" Margin="0,4,0,10"
                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Variedad" Foreground="#AAA" FontSize="11"/>
                <ComboBox x:Name="CmbVariedad" Margin="0,4,0,10"
                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Proceso" Foreground="#AAA" FontSize="11"/>
                <ComboBox x:Name="CmbProceso" Margin="0,4,0,10"
                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Puntuacion (7-10)" Foreground="#AAA" FontSize="11"/>
                <TextBox x:Name="TxtPuntuacion" Margin="0,4,0,10" Padding="6,4"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Cantidad" Foreground="#AAA" FontSize="11"/>
                <TextBox x:Name="TxtCantidad" Margin="0,4,0,10" Padding="6,4"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Nota de cata" Foreground="#AAA" FontSize="11"/>
                <TextBox x:Name="TxtNotaCata" Margin="0,4,0,20" Padding="6,4" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555"/>

                <Button x:Name="BtnGuardar" Content="Guardar" Margin="0,0,0,8"
                        Background="#D4A055" Foreground="White" FontWeight="Bold"
                        Padding="0,8" Click="BtnGuardar_Click"/>
                <Button x:Name="BtnEliminar" Content="Eliminar" Margin="0,0,0,8"
                        Background="#8B3A3A" Foreground="White" FontWeight="Bold"
                        Padding="0,8" Click="BtnEliminar_Click"/>
                <Button x:Name="BtnFicha" Content="Generar Ficha PDF" Margin="0,0,0,0"
                        Background="#3A6B8B" Foreground="White" FontWeight="Bold"
                        Padding="0,8" Click="BtnFicha_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>